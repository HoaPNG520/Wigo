<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Báo cáo</h2>
</div>

<div class="row">
    <div class="col-md-4">
        <select id="projectSelect" class="form-select">
            <option value="">-- Chọn dự án --</option>
            @foreach (var project in Model.Projects)
            {
                <option value="@project.Value" data-project-name="@project.Text">@project.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button id="generateBtn" class="btn btn-primary w-100">Tạo báo cáo</button>
    </div>
</div>

<div id="projectsContainer" class="mt-3">
    @foreach (var project in Model.Projects)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@project.Text</h5>
                <a asp-controller="Reports" asp-action="Generate" asp-route-projectId="@project.Value" class="btn btn-outline-primary w-100">Tạo báo cáo dự án</a>
            </div>
        </div>
    }
</div>

<script>
document.getElementById('generateBtn').addEventListener('click', function() {
    var projectId = document.getElementById('projectSelect').value;
    if (!projectId) {
        alert('Vui lòng chọn dự án');
        return;
    }
    window.location.href = '@Url.Action("Generate", "Reports", new { projectId = 0 }, null)'.replace('0', projectId);
});
</script>