@model Wigo.ViewModels.ReportViewModel

<div class="row mb-3">
    <div class="col-md-6">
        <h4>@Model.ProjectName</h4>
        <small>Ngày tạo: @Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</small>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Số tiền</th>
            <th>Trạng thái</th>
            <th>Người nộp</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var expense in Model.Expenses)
        {
            <tr>
                <td>@expense.Id</td>
                <td>@expense.Amount.Format() ₫</td>
                <td>
                    <span class="badge @(expense.Status == Wigo.Models.Enums.ExpenseStatus.Pending ? "badge-pending" : expense.Status == Wigo.Models.Enums.ExpenseStatus.NeedsMore ? "badge-needsmore" : expense.Status == Wigo.Models.Enums.ExpenseStatus.Recorded ? "badge-recorded" : "badge-rejected")">
                        @expense.Status
                    </span>
                </td>
                <td>@expense.SubmittedBy</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Export" asp-route-projectId="@Model.ProjectId" asp-route-format="csv" class="btn btn-outline-success">Xuất CSV</a>
    <a asp-action="Export" asp-route-projectId="@Model.ProjectId" asp-route-format="pdf" class="btn btn-outline-danger">Xuất PDF</a>
    <a asp-controller="Reports" asp-action="Index" class="btn btn-secondary mt-2">Quay lại</a>
</div>