@model Wigo.ViewModels.ProjectEditViewModel

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Sửa dự án</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Tên dự án</label>
                            <input type="text" asp-for="Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">Trạng thái</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="0">Hoạt động</option>
                                <option value="1">Chuẩn bị</option>
                                <option value="2">Đóng</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Budget" class="form-label">Ngân sách</label>
                            <input type="number" asp-for="Budget" class="form-control" required />
                        </div>
                        <!-- BudgetObj removed from view model -->
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                            <input type="date" asp-for="StartDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
                            <input type="date" asp-for="EndDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PublicEnabled" class="form-label">Công khai</label>
                            <input type="checkbox" asp-for="PublicEnabled" class="form-check-input" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="SubmissionsOpen" class="form-label">Mở nộp</label>
                            <input type="checkbox" asp-for="SubmissionsOpen" class="form-check-input" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label asp-for="CategoryNames" class="form-label">Tên danh mục (cách nhau bằng dấu phẩy)</label>
                            <input type="text" asp-for="CategoryNames" class="form-control" placeholder="Ví dụ: Nhân sự, Vật tư, Xây dựng" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning">Lưu thay đổi</a>
                        <a asp-action="Index" asp-controller="Projects" class="btn btn-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>