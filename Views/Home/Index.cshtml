@{
    ViewData["Title"] = "UII - Minh bạch tài chính cộng đồng";
}

<div class="site-header mb-4">
	<div class="container">
		<div class="d-flex align-items-center">
			<img src="~/brand/uii-mark.png" alt="UEH UII" height="32" class="me-3">
			<span class="text-balance fw-bold fs-3">UII · Minh bạch tài chính cộng đồng</span>
		</div>
	</div>
</div>

<div class="container">
	<div class="row g-4">
		<!-- Hero section -->
		<section class="col-12 col-lg-8 mb-5">
			<div class="px-3 py-5">
				<span class="ebrowlight text-muted small text-uppercase">UII · Minh bạch tài chính cộng đồng</span>
				<h1 class="display-4 fw-bold mt-3">Bắt đầu từ vai trò của bạn.</h1>
				<p class="lead mt-3 text-muted" style="max-width: 600px;">Chào mừng bạn đến với hệ thống tài chính cộng đồng. Chọn vai trò phù hợp để bắt đầu trải nghiệm.</p>
			</div>
		</section>

		<!-- Role cards -->
		<section class="col-12 col-lg-4">
			<div class="role-card featured" style="max-width: 350px; margin: 0 auto;">
				<div class="d-flex align-items-start justify-content-between">
					<div>
						<div class="featured-badge">Đăng nhập quản lý</div>
						<h3 class="mt-3">Người phụ trách tài chính</h3>
						<p class="text-muted mt-2" style="font-size: 0.95rem; line-height: 1.6;">Quản lý chi phí, duyệt hóa đơn và theo dõi ngân sách dự án.</p>
						<ul class="mt-3 list-unstyled">
							<li class="mb-1"><span class="text-primary me-2">✓</span>Theo dõi ngân sách dự án</li>
							<li class="mb-1"><span class="text-primary me-2">✓</span>Duyệt hóa đơn và chi phí</li>
							<li class="mb-1"><span class="text-primary me-2">✓</span>Báo cáo tài chính định kỳ</li>
						</ul>
						<a href="#" class="btn btn-primary mt-3 w-100">Đăng nhập quản lý</a>
					</div>
					<div class="flex-shrink-0">
						<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--brand-purple);">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
							<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
						</svg>
					</div>
				</div>
			</div>

			<div class="role-card" style="max-width: 350px; margin: 1.5rem auto 0; border-color: var(--border);">
				<div class="d-flex align-items-start justify-content-between">
					<div>
						<h3 class="mt-3">Thành viên dự án</h3>
						<p class="text-muted mt-2" style="font-size: 0.95rem; line-height: 1.6;">Tham gia dự án, nộp khoản chi và theo dõi tiến độ.</p>
						<ul class="mt-3 list-unstyled">
							<li class="mb-1"><span class="text-primary me-2">✓</span>Nộp khoản chi dự án</li>
							<li class="mb-1"><span class="text-primary me-2">✓</span>Xem trạng thái duyệt</li>
							<li class="mb-1"><span class="text-primary me-2">✓</span>Theo dõi tiến độ</li>
						</ul>
						<div class="mt-3">
							<a href="#" class="btn btn-outline w-100">Nộp khoản chi</a>
							<a href="#" class="btn btn-ghost w-100 ms-2">Xem Bill của tôi</a>
						</div>
					</div>
					<div class="flex-shrink-0">
						<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: #f49e1b;">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="17 8 12 3 7 8"/>
							<line x1="12" y1="3" x2="12" y2="15"/>
						</svg>
					</div>
				</div>
			</div>

			<div class="role-card" style="max-width: 350px; margin: 1.5rem auto 0; border-color: var(--border);">
				<div class="d-flex align-items-start justify-content-between">
					<div>
						<h3 class="mt-3">Nhà tài trợ</h3>
						<p class="text-muted mt-2" style="font-size: 0.95rem; line-height: 1.6;">Cung cấp vốn tài chính, theo dõi hiệu quả sử dụng.</p>
						<ul class="mt-3 list-unstyled">
							<li class="mb-1"><span class="text-primary me-2">✓</span>Cung cấp vốn dự án</li>
							<li class="mb-1"><span class="text-primary me-2">✓</span>Theo dõi báo cáo</li>
							<li class="mb-1"><span class="text-primary me-2">✓</span>Xem cổng minh bạch</li>
						</ul>
						<a href="#" class="btn btn-outline mt-3 w-100">Xem Cổng minh bạch</a>
					</div>
					<div class="flex-shrink-0">
						<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: #f49e1b;">
							<circle cx="12" cy="12" r="10"/>
							<path d="M8 14s1.5 2 4 2 4-2 4-2"/>
							<line x1="9" y1="9" x2="9.01" y2="9"/>
							<line x1="15" y1="9" x2="15.01" y2="9"/>
						</svg>
					</div>
				</div>
			</div>
		</section>
	</div>

