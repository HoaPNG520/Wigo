@model Wigo.ViewModels.PublicExpenseViewModel

<div class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mx-auto">
                <h4>@Model.Description</h4>
                <hr />
                <div class="d-flex justify-content-between">
                    <small>Id: @Model.ExpenseId</small>
                    <small>Số tiền: @Model.MaskedAmount</small>
                </div>
            </div>
        </div>
    </div>
</div>